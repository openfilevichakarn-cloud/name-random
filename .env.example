# Copy to .env.local and fill in to enable accounts and cloud sync (optional).
# Without these values the app runs in local mode: data stays in this browser.
#
# Supabase dashboard → Project → Connect (or Settings → API Keys).
# Use the PUBLISHABLE key only. Never put the secret / service_role key here:
# every VITE_ variable is shipped to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
