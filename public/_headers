# Cloudflare Pages response headers. The main Content-Security-Policy is a <meta> tag in index.html
# (generated at build time with the Supabase origin); frame-ancestors only works as a header.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Hashed file names: safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
